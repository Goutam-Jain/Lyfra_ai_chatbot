# ---------- Backend ----------
# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name used for every key...
LLM_MODEL=gemini/gemini-2.5-flash
# ...or one model per key (same order as LLM_API_KEYS) to span several models/providers.
# Leave empty to use LLM_MODEL for all keys.
LLM_MODELS=
# Optional custom base URL (OpenAI-compatible gateways). Leave empty for the provider default.
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30
# SQLite location (inside the Docker volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook on POST /chat
ENABLE_FAILURE_SIMULATION=true
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
DEFAULT_SYSTEM_PROMPT="You are a helpful, concise assistant."
# How many previous messages of a session are sent to the model as context
MAX_HISTORY_MESSAGES=40

# ---------- Frontend ----------
# Backend URL as seen from the browser (written into env.js when the frontend container starts)
API_BASE_URL=http://localhost:8000
